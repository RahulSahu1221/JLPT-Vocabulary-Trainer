o(white, { y: 0, opacity: 1, duration: 0.35, ease: \"power2.out\" }, 0);\r\n1566:     };\r\n1567: \r\n1568:     pill.addEventListener(\"mouseenter\", () => { updateLayout(); tl.play(); });\r\n1569:     pill.addEventListener(\"mouseleave\", () => { if (tl) tl.reverse(); });\r\n1570: }\r\n1571: \r\n1572: function initAllPillAnimations() {\r\n1573:     document.querySelectorAll(\".pill, .pill-anim\").forEach(setupGSAPPill);\r\n1574: }\r\n1575: \r\n1576: /* ═══════════════════════════════════════════════════════════════════════════════\r\n1577:    SMART SCROLL (hide nav/toolbar on scroll-down)\r\n1578:    ═══════════════════════════════════════════════════════════════════════════════ */\r\n1579: let lastScrollY = window.scrollY;\r\n1580: const pillNavWrap = $(\"pillNavWrap\");\r\n1581: const floatingToolbar = $(\"floatingToolbar\");\r\n1582: \r\n1583: window.addEventListener(\"scroll\", () => {\r\n1584:     const currentScrollY = window.scrollY;\r\n1585:     if (Math.abs(currentScrollY - lastScrollY) > 10) {\r\n1586:         if (currentScrollY > lastScrollY && currentScrollY > 100) {\r\n1587:             pillNavWrap?.classList.add(\"nav-hidden\");\r\n1588:             floatingToolbar?.classList.add(\"toolbar-hidden\");\r\n1589:         } else {\r\n1590:             pillNavWrap?.classList.remove(\"nav-hidden\");\r\n1591:             floatingToolbar?.classList.remove(\"toolbar-hidden\");\r\n1592:         }\r\n1593:         lastScrollY = currentScrollY;\r\n1594:     }\r\n1595: }, { passive: true });\r\n1596: \r\n1597: /* ═══════════════════════════════════════════════════════════════════════════════\r\n1598:    SRS DOCK — mouse-proximity magnification (macOS-dock style)\r\n1599:    ═══════════════════════════════════════════════════════════════════════════════ */\r\n1600: function setupSRSDock() {\r\n1601:     const dock = $(\"srsDock\");\r\n1602:     if (!dock) return;\r\n1603: \r\n1604:     const items = Array.from(dock.querySelectorAll(\".srs-dock-item\"));\r\n1605:     const buttons = items.map(item => item.querySelector(\".srs-dock-btn\")).filter(Boolean);\r\n1606:     const BASE_SIZE = 56;\r\n1607:     const MAX_SIZE = 88;\r\n1608:     const INFLUENCE = 150;\r\n1609: \r\n1610:     let centers = [];\r\n1611:     let rafPending = false;\r\n1612:     let lastClientX = 0;\r\n1613: \r\n1614:     function recalcCenters() {\r\n1615:         centers = buttons.map(btn => {\r\n1616:             const rect = btn.getBoundingClientRect();\r\n1617:             return rect.left + rect.width / 2;\r\n1618:         });\r\n1619:     }\r\n1620: \r\n1621:     function applyMagnification(clientX) {\r\n1622:         buttons.forEach((btn, i) => {\r\n1623:             const dist = Math.abs(clientX - centers[i]);\r\n1624:             let size = dist < INFLUENCE\r\n1625:                 ? BASE_SIZE + (MAX_SIZE - BASE_SIZE) * Math.pow(1 - dist / INFLUENCE, 1.8)\r\n1626:                 : BASE_SIZE;\r\n1627:             size = Math.round(size);\r\n1628:             btn.style.width = size + \"px\";\r\n1629:             btn.style.height = size + \"px\";\r\n1630:             btn.style.fontSize = Math.round(size * 0.40) + \"px\";\r\n1631:             btn.style.borderRadius = Math.round(size * 0.265) + \"px\";\r\n1632:         });\r\n1633:         rafPending = false;\r\n1634:     }\r\n1635: \r\n1636:     dock.addEventListener(\"mouseenter\", recalcCenters);\r\n1637:     dock.addEventListener(\"mousemove\", e => {\r\n1638:         lastClientX = e.clientX;\r\n1639:         if (!rafPending) {\r\n1640:             rafPending = true;\r\n1641:             requestAnimationFrame(() => applyMagnification(lastClientX));\r\n1642:         }\r\n1643:     });\r\n1644:     dock.addEventListener(\"mouseleave\", () => {\r\n1645:         buttons.forEach(btn => {\r\n1646:             btn.style.width = \"\";\r\n1647:             btn.style.height = \"\";\r\n1648:             btn.style.fontSize = \"\";\r\n1649:             btn.style.borderRadius = \"\";\r\n1650:         });\r\n1651:     });\r\n1652: \r\n1653:     window.addEventListener(\"resize\", () => {\r\n1654:         if (dock.matches(\":hover\")) recalcCenters();\r\n1655:     }, { passive: true });\r\n1656: \r\n1657:     buttons.forEach(btn => {\r\n1658:         btn.addEventListener(\"touchstart\", () => {\r\n1659:             btn.style.width = MAX_SIZE + \"px\";\r\n1660:             btn.style.height = MAX_SIZE + \"px\";\r\n1661:             btn.style.fontSize = Math.round(MAX_SIZE * 0.40) + \"px\";\r\n1662:         }, { passive: true });\r\n1663:         btn.addEventListener(\"touchend\", () => {\r\n1664:             btn.style.width = \"\";\r\n1665:             btn.style.height = \"\";\r\n1666:             btn.style.fontSize = \"\";\r\n1667:         }, { passive: true });\r\n1668:     });\r\n1669: }\r\n1670: \r\n1671: document.addEventListener(\"DOMContentLoaded\", () => {\n1672:     requestAnimationFrame(initAllPillAnimations);\n1673: });\r\n1674: setupSRSDock();\n1675: \n1676: /* ═══════════════════════════════════════════════════════════════════════════════\n1677:    HELPERS & UTILS\n1678:    ═══════════════════════════════════════════════════════════════════════════════ */\n1679: function renderFurigana(kanji, reading) {\n1680:     const showFuri = store.get(\"jlpt_settings_furigana\", true);\n1681:     if (!kanji || kanji === reading) return reading;\n1682:     return `<ruby><rb>${kanji}</rb><rt style=\"${showFuri ? '' : 'visibility:hidden;'}\">${reading}</rt></ruby>`;\n1683: }\n1684: window.renderFurigana = renderFurigana;\n1685: \n1686: /* ═══════════════════════════════════════════════════════════════════════════════\n1687:    PWA INSTALL PROMPT\n1688:    ═══════════════════════════════════════════════════════════════════════════════ */\n1689: let deferredPrompt;\n1690: window.addEventListener('beforeinstallprompt', (e) => {\n1691:     e.preventDefault();\n1692:     deferredPrompt = e;\n1693:     \n1694:     let btn = document.getElementById(\"pwaInstallBtn\");\n1695:     if (!btn) {\n1696:         btn = document.createElement(\"button\");\n1697:         btn.id = \"pwaInstallBtn\";\n1698:         btn.className = \"nav-btn\";\n1699:         btn.style.cssText = \"position:fixed; bottom:20px; right:20px; z-index:9999; background:var(--accent); color:var(--bg); border:none; border-radius:50px; padding:12px 20px; font-weight:bold; box-shadow:0 4px 15px rgba(0,0,0,0.3);\";\n1700:         btn.innerHTML = \"⬇️ Install App\";\n1701:         document.body.appendChild(btn);\n1702:     }\n1703:     btn.style.display = \"block\";\n1704:     \n1705:     btn.addEventListener('click', async () => {\n1706:         btn.style.display = 'none';\n1707:         deferredPrompt.prompt();\n1708:         const { outcome } = await deferredPrompt.userChoice;\n1709:         console.log(`User response to the install prompt: ${outcome}`);\n1710:         deferredPrompt = null;\n1711:     });\n1712: });\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
