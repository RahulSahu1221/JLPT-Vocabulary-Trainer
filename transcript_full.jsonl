         if (e.key === \"4\") $(\"srsBtn4\")?.click();\r\n1603:     }\r\n1604: \r\n1605:     if (currentView === \"quizView\") {\r\n1606:         const tag = document.activeElement?.tagName;\r\n1607:         if (tag === \"INPUT\" || tag === \"TEXTAREA\") {\r\n1608:             if (e.key === \"Enter\") { e.preventDefault(); $(\"typingSubmitBtn\")?.click(); }\r\n1609:             return;\r\n1610:         }\r\n1611:         \r\n1612:         if (e.key === \"1\") { e.preventDefault(); $(\"optionA\")?.click(); }\r\n1613:         if (e.key === \"2\") { e.preventDefault(); $(\"optionB\")?.click(); }\r\n1614:         if (e.key === \"3\") { e.preventDefault(); $(\"optionC\")?.click(); }\r\n1615:         if (e.key === \"4\") { e.preventDefault(); $(\"optionD\")?.click(); }\r\n1616:         \r\n1617:         if (e.key === \" \" || e.key === \"Enter\") {\r\n1618:             e.preventDefault();\r\n1619:             const resultBox = document.getElementById(\"quizResult\");\r\n1620:             if (resultBox && resultBox.innerHTML.trim() !== \"\") {\r\n1621:                 const nextBtns = resultBox.querySelectorAll(\"button\");\r\n1622:                 if (nextBtns.length > 0) nextBtns[0].click();\r\n1623:             } else if (typeof quizMode !== \"undefined\" && quizMode === \"listening\") {\r\n1624:                 const btn = document.getElementById(\"quizSpeakBtn\");\r\n1625:                 if (btn) btn.click();\r\n1626:             }\r\n1627:         }\r\n1628:     }\r\n1629: });\r\n1630: \r\n1631: function toggleCmdPalette() {\r\n1632:     const o = $(\"cmdOverlay\"), i = $(\"cmdInput\");\r\n1633:     if (!o || !i) return;\r\n1634:     if (o.classList.contains(\"hidden\")) { o.classList.remove(\"hidden\"); i.value = \"\"; i.focus(); renderCmd(); }\r\n1635:     else { o.classList.add(\"hidden\"); }\r\n1636: }\r\n1637: window.toggleCmdPalette = toggleCmdPalette;\r\n1638: $(\"cmdPaletteMobileBtn\")?.addEventListener(\"click\", toggleCmdPalette);\r\n1639: $(\"cmdCloseBtn\")?.addEventListener(\"click\", () => closeModal(\"cmdOverlay\"));\r\n1640: \r\n1641: $(\"cmdInput\")?.addEventListener(\"input\", e => renderCmd(e.target.value.toLowerCase()));\r\n1642: function renderCmd(q = \"\") {\r\n1643:     const r = $(\"cmdResults\");\r\n1644:     if (!r) return;\r\n1645:     r.innerHTML = \"\";\r\n1646:     const matches = commands.filter(c => c.n.toLowerCase().includes(q));\r\n1647:     matches.forEach(c => {\r\n1648:         const li = document.createElement(\"li\");\r\n1649:         li.className = \"cmd-item\";\r\n1650:         li.tabIndex = 0;\r\n1651:         const nameSpan = document.createElement(\"span\");\r\n1652:         nameSpan.textContent = c.n;\r\n1653:         const kbdSpan = document.createElement(\"span\");\r\n1654:         kbdSpan.className = \"cmd-kbd\";\r\n1655:         kbdSpan.textContent = c.k;\r\n1656:         li.appendChild(nameSpan);\r\n1657:         li.appendChild(kbdSpan);\r\n1658:         li.addEventListener(\"click\", () => { c.a(); toggleCmdPalette(); });\r\n1659:         r.appendChild(li);\r\n1660:     });\r\n1661: }\r\n1662: \r\n1663: /* ═══════════════════════════════════════════════════════════════════════════════\r\n1664:    FEEDBACK MODAL\r\n1665:    ═══════════════════════════════════════════════════════════════════════════════ */\r\n1666: $(\"feedbackFab\")?.addEventListener(\"click\", () => $(\"feedbackOverlay\")?.classList.remove(\"hidden\"));\r\n1667: function closeFeedback() {\r\n1668:     closeModal(\"feedbackOverlay\");\r\n1669:     if ($(\"feedbackText\")) $(\"feedbackText\").value = \"\";\r\n1670: }\r\n1671: window.closeFeedback = closeFeedback;\r\n1672: \r\n1673: $(\"submitFeedbackBtn\")?.addEventListener(\"click\", () => {\r\n1674:     const c = $(\"feedbackCategory\")?.value || \"Other\";\r\n1675:     const t = $(\"feedbackText\")?.value || \"\";\r\n1676:     const to = \"sahurahulcoc@gmail.com\";\r\n1677:     const subject = encodeURIComponent(`Ronin Feedback: ${c}`);\r\n1678:     const body