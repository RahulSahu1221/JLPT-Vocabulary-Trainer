2:     updateThemeLabels(isLight);\r\n1713: });\r\n1714: \r\n1715: const isLightTheme = store.get(\"jlpt_theme\") === \"light\";\r\n1716: if (isLightTheme) document.body.classList.add(\"light-theme\");\r\n1717: updateThemeLabels(isLightTheme);\r\n1718: const metaThemeInit = document.getElementById(\"metaThemeColor\");\r\n1719: if (metaThemeInit) metaThemeInit.content = isLightTheme ? \"#e2e8f0\" : \"#07080d\";\r\n1720: \r\n1721: /* ═══════════════════════════════════════════════════════════════════════════════\r\n1722:    INITIALIZATION\r\n1723:    ═══════════════════════════════════════════════════════════════════════════════ */\r\n1724: const initLvl = store.get(\"jlpt_lastLesson\", 1);\r\n1725: loadLesson(initLvl);\r\n1726: \r\n1727: const _startHash = (window.location.hash || \"\").replace(\"#\", \"\");\r\n1728: if (_startHash === \"review\") {\r\n1729:     showView(\"reviewView\");\r\n1730:     syncNavPill(\"review\");\r\n1731:     setTimeout(() => startReview(), 50);\r\n1732: } else if (_startHash === \"quiz\") {\r\n1733:     showView(\"quizView\");\r\n1734:     syncNavPill(\"quiz\");\r\n1735:     setTimeout(() => startNewQuiz(), 50);\r\n1736: } else {\r\n1737:     showView(\"dashboardView\");\r\n1738:     syncNavPill(\"dashboard\");\r\n1739: }\r\n1740: \r\n1741: /* ═══════════════════════════════════════════════════════════════════════════════\r\n1742:    GSAP FLUID PILL-HOVER ANIMATION\r\n1743:    ═══════════════════════════════════════════════════════════════════════════════ */\r\n1744: function setupGSAPPill(pill) {\r\n1745:     const circle = pill.querySelector(\".hover-circle\");\r\n1746:     const label = pill.querySelector(\".pill-label\");\r\n1747:     const white = pill.querySelector(\".pill-label-hover\");\r\n1748: \r\n1749:     if (!circle || !label || !white || pill.dataset.gsapBound || typeof gsap === \"undefined\") return;\r\n1750:     pill.dataset.gsapBound = \"true\";\r\n1751:     let tl;\r\n1752: \r\n1753:     const updateLayout = () => {\r\n1754:         const w = pill.offsetWidth || 120;\r\n1755:         const h = pill.offsetHeight || 36;\r\n1756:         const R = ((w * w) / 4 + h * h) / (2 * h);\r\n1757:         const D = Math.ceil(2 * R) + 2;\r\n1758:         const delta = Math.ceil(R - Math.sqrt(Math.max(0, R * R - (w * w) / 4))) + 1;\r\n1759:         const originY = D - delta;\r\n1760: \r\n1761:         circle.style.width = `${D}px`;\r\n1762:         circle.style.height = `${D}px`;\r\n1763:         circle.style.bottom = `-${delta}px`;\r\n1764: \r\n1765:         gsap.set(circle, { xPercent: -50, scale: 0, transformOrigin: `50% ${originY}px` });\r\n1766:         gsap.set(label, { y: 0 });\r\n1767:         gsap.set(white, { y: h + 10, opacity: 0 });\r\n1768: \r\n1769:         if (tl) tl.kill();\r\n1770:         tl = gsap.timeline({ paused: true });\r\n1771:         tl.to(circle, { scale: 1.2, duration: 0.35, ease: \"power2.out\" }, 0);\r\n1772:         tl.to(label, { y: -(h + 5), duration: 0.35, ease: \"power2.out\" }, 0);\r\n1773:         tl.to(white, { y: 0, opacity: 1, duration: 0.35, ease: \"power2.out\" }, 0);\r\n1774:     };\r\n1775: \r\n1776:     pill.addEventListener(\"mouseenter\", () => { updateLayout(); tl.play(); });\r\n1777:     pill.addEventListener(\"mouseleave\", () => { if (tl) tl.reverse(); });\r\n1778: }\r\n1779: \r\n1780: function initAllPillAnimations() {\r\n1781:     document.querySelectorAll(\".pill, .pill-anim\").forEach(setupGSAPPill);\r\n1782: }\r\n1783: \r\n1784: /* ═══════════════════════════════════════════════════════════════════════════════\r\n1785:    SMART SCROLL (hide nav/toolbar on scroll-down)\r\n1786:    ═══════════════════════════════════════════════════════════════════════════════ */\r\n1787: let lastScrollY = window.scrollY;\r\n1788: const pillNavWrap = $(\"pillNavWrap\");\r\n1789: const floatingToolbar = $(\"floatingToolbar\");\r\n1790: \r\n1791: window.addEventListener(\"scroll\", () => {\r\n1792:     const currentScrollY = window.scrollY;\r\n1793:     if (Math.abs(currentScrollY - lastScrollY) > 10) {\r\n1794:         if (currentScrollY > lastScrollY && currentScrollY > 100) {\r\n1795:             pillNavWrap?.classList.add(\"nav-hidden\");\r\n1796:             floatingToolbar?.classList.add(\"toolbar-hidden\");\r\n1797:         } else {\r\n1798:             pillNavWrap?.classList.remove(\"nav-hidden\");\r\n1799:             floatingToolbar?.classList.remove(\"toolbar-hidden\");\r\n1800:         }\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
