nt Unlocked: ${title}!`, \"success\");\r\n529:         updateDashboard();\r\n530:     }\r\n531: }\r\n532: \r\n533: /* ═══════════════════════════════════════════════════════════════════════════════\r\n534:    LOAD LESSON\r\n535:    ═══════════════════════════════════════════════════════════════════════════════ */\r\n536: async function loadLesson(num, level = document.getElementById('levelDropdown') ? document.getElementById('levelDropdown').value : 'n5') {\r\n537:     try {\r\n538:         const res = await fetch(`data/${level}/lesson${num}.json`);\r\n539:         if (!res.ok) throw new Error(`HTTP ${res.status}`);\r\n540:         const raw = await res.json();\r\n541:         const data = Array.isArray(raw) ? raw : (raw.vocabulary || raw.words || raw.items || []);\r\n542:         if (!Array.isArray(data)) throw new Error(\"Malformed lesson data\");\r\n543: \r\n544:         vocabulary = data.map(item => ({\r\n545:             kanji: item.kanji || item.word || \"\",\r\n546:             hiragana: item.hiragana || item.reading || \"\",\r\n547:             meaning: item.meaning || item.english || \"\",\r\n548:             memory: item.memory || \"\",\r\n549:             example: item.example || \"\",\r\n550:             section: item.section || \"Vocabulary\",\r\n551:             emoji: item.emoji || \"📘\"\r\n552:         })).filter(w => w.kanji || w.hiragana || w.meaning);\r\n553: \r\n554:         filteredVocabulary = [...vocabulary];\r\n555:         window.vocabulary = vocabulary;\r\n556:         window.filteredVocabulary = filteredVocabulary;\r\n557: \r\n558:         store.set(\"jlpt_lastLesson\", num);\r\n559:         safeText($(\"lessonSelected\"), `Lesson ${num}`);\r\n560: \r\n561:         vocabulary.forEach(v => {\r\n562:             const key = wordKey(v);\r\n563:             if (key && !srsData[key]) srsData[key] = { interval: 0, repetition: 0, eFactor: 2.5, dueDate: Date.now() };\r\n564:         });\r\n565:         store.set(\"jlpt_srs\", srsData);\r\n566: \r\n567:         updateDashboard();\r\n568:         if (currentView === \"vocabView\") renderVocabulary();\r\n569:         if (currentView === \"reviewView\") startReview();\r\n570: \r\n571:     } catch (err) {\r\n572:         console.warn(`Lesson ${num} load failed:`, err);\r\n573:         showToast(`Lesson ${num} is not available yet.`, \"error\");\r\n574:         const lastWorking = store.get(\"jlpt_lastLesson\", 1);\r\n575:         safeText($(\"lessonSelected\"), `Lesson ${lastWorking}`);\r\n576:     }\r\n577: }\r\n578: window.loadLesson = loadLesson;\r\n579: \r\n580: /* ═══════════════════════════════════════════════════════════════════════════════\r\n581:    DASHBOARD\r\n582:    ═══════════════════════════════════════════════════════════════════════════════ */\r\n583: function updateDashboard() {\r\n584:     const greeting = document.getElementById(\"dashGreeting\");\r\n585:     if (greeting) greeting.textContent = `Welcome Back, ${userProfile.name || \"Learner\"}!`;\r\n586:     \r\n587:     safeText($(\"streakStat\"), `🔥 ${userProfile.streak} Days`);\r\n588:     safeText($(\"totalLearnedStat\"), `${userProfile.learned.length} Words`);\r\n589: \r\n590:     const now = Date.now();\r\n591:     const dueCount = Object.values(srsData).filter(v => v && v.dueDate <= now).length;\r\n592:     safeText($(\"dueReviewStat\"), `${dueCount} Due`);\r\n593: \r\n594:     const pct = Math.min(100, Math.round((userProfile.wordsStudiedToday / userProfile.dailyGoal) * 100));\r\n595:     safeText($(\"dailyGoalStat\"), `${userProfile.wordsStudiedToday} / ${userProfile.dailyGoal}`);\r\n596:     if ($(\"goalProgressFill\")) $(\"goalProgressFill\").style.width = `${pct}%`;\r\n597: \r\n598:     const lessonLearned = vocabulary.filter(item => userProfile.learned.includes(wordKey(item))).length;\r\n599:     const lPct = vocabulary.length ? Math.round((lessonLearned / vocabulary.length) * 100) : 0;\r\n600:     if ($(\"progressFill\")) $(\"progressFill\").style.width = lPct + \"%\";\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
